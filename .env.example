# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/luckywiki

# Application and authentication
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Initial root account used by `pnpm prisma db seed`
ROOT_EMAIL=root@luckywiki.local
ROOT_PASSWORD=ChangeMe123!
ROOT_NAME=LuckyWiki Root

# Site metadata
SITE_NAME=LuckyWiki
SITE_DESCRIPTION=A lightweight knowledge base for your team
SITE_LOGO_URL=
SITE_FAVICON_URL=
SITE_FOOTER_COPYRIGHT=
SITE_FOOTER_ICP=

# Wiki agent. Leave OPENAI_API_KEY empty to disable embeddings and chat.
OPENAI_API_KEY=
OPENAI_RESPONSES_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_BASE_URL=https://api.openai.com/v1
AGENT_EMBEDDING_DIMENSIONS=1024

# Optional direct database URLs for Prisma and ParadeDB deployments
PRISMA_DATABASE_URL=
PARADEDB_DATABASE_URL=
PARADEDB_SSL_MODE=
PRISMA_TRANSACTION_MAX_WAIT_MS=15000
PRISMA_TRANSACTION_TIMEOUT_MS=60000

# Optional authentication providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=SSO

# Optional verification email delivery
RESEND_API_KEY=
EMAIL_FROM=

# Optional image hosting: configure either Vercel Blob or an S3-compatible provider
BLOB_READ_WRITE_TOKEN=
IMAGE_HOSTING_BUCKET=
IMAGE_HOSTING_REGION=auto
IMAGE_HOSTING_ACCESS_KEY_ID=
IMAGE_HOSTING_SECRET_ACCESS_KEY=
IMAGE_HOSTING_PUBLIC_URL_BASE=
IMAGE_HOSTING_ENDPOINT=
IMAGE_HOSTING_PATH_PREFIX=wiki-assets
IMAGE_UPLOAD_MAX_BYTES=5242880

# Optional MCP API key and rate limiting
MCP_SERVER_API_KEY=
MCP_RATE_LIMIT=200

# Required in production for shared rate limits
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
