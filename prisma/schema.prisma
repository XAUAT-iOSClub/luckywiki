generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ROOT
  AUTHOR
  USER
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LogAction {
  CREATE_ARTICLE
  UPDATE_ARTICLE
  MOVE_ARTICLE
  RENAME_FOLDER
  DELETE_ARTICLE
  ARCHIVE_ARTICLE
  RESTORE_ARTICLE
  HARD_DELETE_ARTICLE
  APPROVE_COMMENT
  REJECT_COMMENT
  SET_ARTICLE_STATUS
  SET_USER_ROLE
  DELETE_MEDIA
  CLEANUP_MEDIA
}

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false) @map("email_verified")
  emailVerifiedAt  DateTime? @map("email_verified_at")
  image            String?
  role             Role      @default(USER)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  sessions         Session[]
  accounts         Account[]
  articles         Article[] @relation("ArticleAuthor")
  articleRevisions ArticleRevision[] @relation("ArticleRevisionAuthor")
  comments         Comment[] @relation("CommentAuthor")
  approvedComments Comment[] @relation("CommentApprover")
  logs             Log[]
  mcpApiKeys       McpApiKey[]
  mediaAssets      MediaAsset[]
  webhookConfigs   WebhookConfig[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model Article {
  id          String        @id @default(cuid())
  path        String        @unique
  title       String
  description String?
  tags        String[]      @default([])
  editor      String?
  markdown    String
  status      ArticleStatus @default(DRAFT)
  authorId    String        @map("author_id")
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  author      User          @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  revisions   ArticleRevision[]
  comments    Comment[]
  agentChunks AgentChunk[]
  mediaReferences MediaReference[]
  redirects   ArticleRedirect[]

  @@index([status])
  @@index([authorId])
  @@map("articles")
}

// Immutable snapshot of an article's content at save time. Article only keeps
// the current markdown, so these rows are the version history used for diffs
// and rollbacks.
// Old URL of an article. Only the old path is persisted: the redirect target is
// always the article's current `path`, so moving a page repeatedly (x → y → z)
// never produces redirect chains, and deleting the article removes its rows.
model ArticleRedirect {
  id        String    @id @default(cuid())
  oldPath   String    @unique @map("old_path") // canonical, lowercase
  articleId String    @map("article_id")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") // actor user id, no FK on purpose
  hitCount  Int       @default(0) @map("hit_count")
  lastHitAt DateTime? @map("last_hit_at")
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@map("article_redirects")
}

model ArticleRevision {
  id        String   @id @default(cuid())
  articleId String   @map("article_id")
  markdown  String
  title     String
  authorId  String   @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author    User     @relation("ArticleRevisionAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([articleId, createdAt])
  @@index([authorId])
  @@map("article_revisions")
}

model AgentChunk {
  id         String   @id @default(cuid())
  articleId  String   @map("article_id")
  chunkIndex Int      @map("chunk_index")
  heading    String?
  content    String
  embedding  Unsupported("vector(1024)")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, chunkIndex])
  @@index([articleId])
  @@map("agent_chunks")
}

model Comment {
  id           String        @id @default(cuid())
  articleId    String        @map("article_id")
  authorId     String        @map("author_id")
  body         String
  status       CommentStatus @default(PENDING)
  approvedById String?       @map("approved_by_id")
  approvedAt   DateTime?     @map("approved_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  article      Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author       User          @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  approver     User?         @relation("CommentApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([articleId, status])
  @@index([authorId])
  @@index([approvedById])
  @@map("comments")
}

model Log {
  id         String    @id @default(cuid())
  action     LogAction
  targetType String    @map("target_type")
  targetId   String    @map("target_id")
  detail     String?
  userId     String    @map("user_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([action])
  @@index([userId])
  @@index([createdAt])
  @@map("logs")
}

// MCP API Key —— 每用户可创建多个，用于外部 AI 服务调用百科 MCP 接口
model McpApiKey {
  id          String   @id @default(cuid())
  name        String   // 用户给 key 起的名字，便于管理
  keyHash     String   @unique @map("key_hash") // sha256(key)，不存明文
  prefix      String   // key 前缀（前 8 位），用于展示
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 限流配置：每 24 小时最大调用次数，null = 不限制
  rateLimit   Int?     @map("rate_limit")
  // 使用统计
  lastUsedAt  DateTime? @map("last_used_at")
  totalCalls  Int      @default(0) @map("total_calls")
  // 软删除
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  callLogs    McpCallLog[]

  @@index([userId])
  @@index([keyHash])
  @@map("mcp_api_keys")
}

// MCP 调用日志（便于审计和排查问题）
model McpCallLog {
  id         String   @id @default(cuid())
  apiKeyId   String   @map("api_key_id")
  apiKey     McpApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  method     String   // tools/call, tools/list, initialize 等
  toolName   String?  @map("tool_name") // 具体工具名
  status     String   // success / error / rate_limited
  errorCode  Int?     @map("error_code")
  durationMs Int      @map("duration_ms")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([apiKeyId])
  @@index([userId])
  @@index([createdAt])
  @@index([toolName])
  @@map("mcp_call_logs")
}

// Media library: every uploaded image gets a row here so it can be browsed,
// searched, reference-counted, and safely removed from blob storage.
model MediaAsset {
  id           String    @id @default(cuid())
  storageKey   String    @unique @map("storage_key")
  url          String    @unique
  provider     String // "vercel-blob" | "s3"
  fileName     String    @map("file_name")
  mimeType     String    @map("mime_type")
  size         Int
  width        Int?
  height       Int?
  altText      String?   @map("alt_text")
  uploadedById String?   @map("uploaded_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  // Refreshed whenever an article body still uses this asset. Orphan cleanup
  // only touches assets whose last use is older than the grace period.
  lastUsedAt   DateTime  @default(now()) @map("last_used_at")
  // Cleanup lock: set atomically before deleting the object so an article save
  // cannot re-reference an asset that is already being removed.
  deletedAt    DateTime? @map("deleted_at")
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  references   MediaReference[]

  @@index([createdAt])
  @@index([lastUsedAt])
  @@index([uploadedById])
  @@map("media_assets")
}

// A distinct current article that references the asset. Revision history is
// intentionally not tracked: old snapshots must not keep removed images alive
// forever. Restoring a revision re-syncs these rows.
model MediaReference {
  id        String     @id @default(cuid())
  assetId   String     @map("asset_id")
  articleId String     @map("article_id")
  createdAt DateTime   @default(now()) @map("created_at")
  asset     MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  article   Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([assetId, articleId])
  @@index([articleId])
  @@map("media_references")
}

// Webhook 出站通知：管理员可配置 URL，当文章发生关键事件时推送
model WebhookConfig {
  id          String   @id @default(cuid())
  name        String   // 管理员给 webhook 起的名字
  url         String   // 接收事件的 URL
  events      String[] // 订阅的事件类型：article.published / article.updated / article.archived / article.restored / article.deleted
  secret      String   // HMAC 签名密钥（用于验证请求来源）
  active      Boolean  @default(true)
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deliveryLogs WebhookDeliveryLog[]

  @@index([userId])
  @@index([active])
  @@map("webhook_configs")
}

// Webhook 投递日志（便于审计和排查问题）
model WebhookDeliveryLog {
  id         String   @id @default(cuid())
  webhookId  String   @map("webhook_id")
  event      String   // 事件类型
  payload    String   // JSON payload
  status     String   // success / error
  statusCode Int?     @map("status_code")
  error      String?
  durationMs Int      @map("duration_ms")
  retries    Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  webhook    WebhookConfig @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([event])
  @@index([createdAt])
  @@map("webhook_delivery_logs")
}
