generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ROOT
  AUTHOR
  USER
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LogAction {
  CREATE_ARTICLE
  UPDATE_ARTICLE
  DELETE_ARTICLE
  APPROVE_COMMENT
  REJECT_COMMENT
  SET_ARTICLE_STATUS
  SET_USER_ROLE
}

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false) @map("email_verified")
  emailVerifiedAt  DateTime? @map("email_verified_at")
  image            String?
  role             Role      @default(USER)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  sessions         Session[]
  accounts         Account[]
  articles         Article[] @relation("ArticleAuthor")
  comments         Comment[] @relation("CommentAuthor")
  approvedComments Comment[] @relation("CommentApprover")
  logs             Log[]
  mcpApiKeys       McpApiKey[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model Article {
  id          String        @id @default(cuid())
  path        String        @unique
  title       String
  description String?
  tags        String[]      @default([])
  editor      String?
  markdown    String
  status      ArticleStatus @default(DRAFT)
  authorId    String        @map("author_id")
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  author      User          @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  comments    Comment[]
  agentChunks AgentChunk[]

  @@index([status])
  @@index([authorId])
  @@map("articles")
}

model AgentChunk {
  id         String   @id @default(cuid())
  articleId  String   @map("article_id")
  chunkIndex Int      @map("chunk_index")
  heading    String?
  content    String
  embedding  String
  // Kept alongside the JSON value for backwards compatibility with existing
  // records and embedding models. ParadeDB/pgvector uses this column for
  // indexed cosine-distance queries.
  embeddingVector Unsupported("vector(1024)")? @map("embedding_vector")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, chunkIndex])
  @@index([articleId])
  @@map("agent_chunks")
}

model Comment {
  id           String        @id @default(cuid())
  articleId    String        @map("article_id")
  authorId     String        @map("author_id")
  body         String
  status       CommentStatus @default(PENDING)
  approvedById String?       @map("approved_by_id")
  approvedAt   DateTime?     @map("approved_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  article      Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author       User          @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  approver     User?         @relation("CommentApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([articleId, status])
  @@index([authorId])
  @@index([approvedById])
  @@map("comments")
}

model Log {
  id         String    @id @default(cuid())
  action     LogAction
  targetType String    @map("target_type")
  targetId   String    @map("target_id")
  detail     String?
  userId     String    @map("user_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([action])
  @@index([userId])
  @@index([createdAt])
  @@map("logs")
}

// MCP API Key —— 每用户可创建多个，用于外部 AI 服务调用百科 MCP 接口
model McpApiKey {
  id          String   @id @default(cuid())
  name        String   // 用户给 key 起的名字，便于管理
  keyHash     String   @unique @map("key_hash") // sha256(key)，不存明文
  prefix      String   // key 前缀（前 8 位），用于展示
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 限流配置：每 24 小时最大调用次数，null = 不限制
  rateLimit   Int?     @map("rate_limit")
  // 使用统计
  lastUsedAt  DateTime? @map("last_used_at")
  totalCalls  Int      @default(0) @map("total_calls")
  // 软删除
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  callLogs    McpCallLog[]

  @@index([userId])
  @@index([keyHash])
  @@map("mcp_api_keys")
}

// MCP 调用日志（便于审计和排查问题）
model McpCallLog {
  id         String   @id @default(cuid())
  apiKeyId   String   @map("api_key_id")
  apiKey     McpApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  method     String   // tools/call, tools/list, initialize 等
  toolName   String?  @map("tool_name") // 具体工具名
  status     String   // success / error / rate_limited
  errorCode  Int?     @map("error_code")
  durationMs Int      @map("duration_ms")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([apiKeyId])
  @@index([userId])
  @@index([createdAt])
  @@index([toolName])
  @@map("mcp_call_logs")
}

enum RagApiKeyStatus {
  ACTIVE
  REVOKED
}

// RAG API Key —— 用于 Flutter 等外部应用调用 RAG 检索接口
model RagApiKey {
  id          String          @id @default(cuid())
  name        String
  keyHash     String          @unique @map("key_hash")
  keyPrefix   String          @map("key_prefix")
  status      RagApiKeyStatus @default(ACTIVE)
  hourlyLimit Int?            @map("hourly_limit")
  createdAt   DateTime        @default(now()) @map("created_at")
  lastUsedAt  DateTime?       @map("last_used_at")
  revokedAt   DateTime?       @map("revoked_at")
  createdById String?         @map("created_by_id")

  logs RagCallLog[]

  @@index([status])
  @@index([createdAt])
  @@map("rag_api_keys")
}

// RAG 调用日志
model RagCallLog {
  id          String   @id @default(cuid())
  keyId       String?  @map("key_id")
  ip          String?
  userAgent   String?  @map("user_agent")
  method      String
  path        String
  query       String
  mode        String
  topK        Int      @map("top_k")
  latencyMs   Int      @map("latency_ms")
  resultCount Int      @map("result_count")
  statusCode  Int      @map("status_code")
  errorCode   String?  @map("error_code")
  createdAt   DateTime @default(now()) @map("created_at")

  key RagApiKey? @relation(fields: [keyId], references: [id], onDelete: SetNull)

  @@index([keyId, createdAt])
  @@index([createdAt])
  @@map("rag_call_logs")
}
