generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ROOT
  AUTHOR
  USER
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LogAction {
  CREATE_ARTICLE
  UPDATE_ARTICLE
  DELETE_ARTICLE
  APPROVE_COMMENT
  REJECT_COMMENT
  SET_ARTICLE_STATUS
  SET_USER_ROLE
}

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false) @map("email_verified")
  emailVerifiedAt  DateTime? @map("email_verified_at")
  image            String?
  role             Role      @default(USER)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  sessions         Session[]
  accounts         Account[]
  articles         Article[] @relation("ArticleAuthor")
  comments         Comment[] @relation("CommentAuthor")
  approvedComments Comment[] @relation("CommentApprover")
  logs             Log[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model Article {
  id          String        @id @default(cuid())
  path        String        @unique
  title       String
  description String?
  tags        String[]      @default([])
  editor      String?
  markdown    String
  status      ArticleStatus @default(DRAFT)
  authorId    String        @map("author_id")
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  author      User          @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  comments    Comment[]
  agentChunks AgentChunk[]

  @@index([status])
  @@index([authorId])
  @@map("articles")
}

model AgentChunk {
  id         String   @id @default(cuid())
  articleId  String   @map("article_id")
  chunkIndex Int      @map("chunk_index")
  heading    String?
  content    String
  embedding  String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, chunkIndex])
  @@index([articleId])
  @@map("agent_chunks")
}

model Comment {
  id           String        @id @default(cuid())
  articleId    String        @map("article_id")
  authorId     String        @map("author_id")
  body         String
  status       CommentStatus @default(PENDING)
  approvedById String?       @map("approved_by_id")
  approvedAt   DateTime?     @map("approved_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  article      Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author       User          @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  approver     User?         @relation("CommentApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([articleId, status])
  @@index([authorId])
  @@index([approvedById])
  @@map("comments")
}

model Log {
  id         String    @id @default(cuid())
  action     LogAction
  targetType String    @map("target_type")
  targetId   String    @map("target_id")
  detail     String?
  userId     String    @map("user_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([action])
  @@index([userId])
  @@index([createdAt])
  @@map("logs")
}

model SiteSettings {
  id          String   @id @default("default")
  siteName    String   @default("LuckyWiki") @map("site_name")
  description String?  @map("description")
  logoUrl     String?  @map("logo_url")
  faviconUrl  String?  @map("favicon_url")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}
